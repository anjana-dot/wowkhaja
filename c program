
#include <stdio.h>

int main() {
    unsigned char reg1, reg2, result;
    int temp;
    int borrow;

    printf("=== 8-bit Binary Subtraction with Borrow Detection ===\n\n");

    char binary1[20], binary2[20];
    int len1, len2;
    int valid;

    // ---------------- FIRST INPUT ----------------
    valid = 0;
    while (!valid) {
        printf("Enter first 8-bit binary value: ");
        scanf("%s", binary1);

        len1 = 0;
        while (binary1[len1] != '\0') len1++;
        if (len1 > 8) {
            printf("Error: Input has %d bits (maximum 8 bits allowed)! Try again.\n", len1);
            continue;
        }

        reg1 = 0;
        valid = 1;
        for (int i = 0; binary1[i] != '\0'; i++) {
            if (binary1[i] != '0' && binary1[i] != '1') {
                printf("Error: Invalid binary digit! Use only 0 and 1. Try again.\n");
                valid = 0;
                break;
            }
            reg1 = reg1 * 2 + (binary1[i] - '0');
        }
    }

    // ---------------- SECOND INPUT ----------------
    valid = 0;
    while (!valid) {
        printf("Enter second 8-bit binary value: ");
        scanf("%s", binary2);

        len2 = 0;
        while (binary2[len2] != '\0') len2++;
        if (len2 > 8) {
            printf("Error: Input has %d bits (maximum 8 bits allowed)! Try again.\n", len2);
            continue;
        }

        reg2 = 0;
        valid = 1;
        for (int i = 0; binary2[i] != '\0'; i++) {
            if (binary2[i] != '0' && binary2[i] != '1') {
                printf("Error: Invalid binary digit! Use only 0 and 1. Try again.\n");
                valid = 0;
                break;
            }
            reg2 = reg2 * 2 + (binary2[i] - '0');
        }
    }

    // ---------------- SUBTRACTION ----------------
    temp = reg1 - reg2;
    borrow = (reg1 < reg2) ? 1 : 0;
    result = temp;

    // ---------------- OUTPUT ----------------
    printf("\n--- Binary Subtraction ---\n");

    printf("  ");
    for (int i = 7; i >= 0; i--) printf("%d", (reg1 >> i) & 1);

    printf("\n- ");
    for (int i = 7; i >= 0; i--) printf("%d", (reg2 >> i) & 1);

    printf("\n  --------");

    printf("\n  ");
    for (int i = 7; i >= 0; i--) printf("%d", (result >> i) & 1);

    if (borrow)
        printf("  [BORROW OCCURRED!]");
    else
        printf("  [No borrow]");

    printf("\n");

    return 0;
}